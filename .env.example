# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Option A: GPT-5.4-mini on Azure AI Foundry (install with: uv sync --extra azure) ---
LLM_PROVIDER=azure_foundry
# The deployment name, not the model id.
LLM_MODEL=gpt-5.4-mini
# The deployment's OpenAI-compatible v1 endpoint.
AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
# Leave empty to authenticate with Microsoft Entra ID instead (az login, managed identity).
AZURE_AI_API_KEY=
# LLM_REASONING_EFFORT=low
# LLM_CONCURRENCY=4

# --- Option B: Gemini on the Gemini API (free key: https://aistudio.google.com/apikey) ---
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.5-flash-lite
# GOOGLE_API_KEY=

# --- Optional: Anthropic (install with: uv sync --extra anthropic) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
