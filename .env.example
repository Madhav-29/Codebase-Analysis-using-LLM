# Copy to .env and fill in. .env is gitignored; never commit it.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
# LLM_TEMPERATURE=0
# LLM_CONCURRENCY=1

